		"@nuxt/image": "2.0.0",
		"@nuxt/ui": "4.4.0",
		"@orpc/client": "1.13.4",
		"@orpc/server": "1.13.4",
		"@orpc/tanstack-query": "1.13.4",
		"@orpc/zod": "1.13.4",
		"@prisma/adapter-pg": "7.3.0",
		"@prisma/client": "7.3.0",
		"@tanstack/vue-query": "5.92.9",
		"@unovis/ts": "1.6.4",
		"@unovis/vue": "1.6.4",
		"@vueuse/core": "14.2.1",
		"@vueuse/nuxt": "14.2.1",
		"better-auth": "1.4.18",
		"bullmq": "5.67.3",
		"cheerio": "1.2.0",
		"consola": "3.4.2",
		"ioredis": "5.9.2",
		"isomorphic-dompurify": "2.36.0",
		"marked": "17.0.1",
		"meilisearch": "0.55.0",
		"nitropack": "2.13.1",
		"nodemailer": "7.0.12",
		"nuxt": "4.3.1",
		"nuxt-charts": "2.1.1",
		"nuxt-email-renderer": "2.3.0",
		"nuxt-nodemailer": "1.1.4",
		"p-limit": "7.3.0",
		"p-retry": "7.1.1",
		"papaparse": "5.5.3",
		"pg": "8.18.0",
		"protobufjs": "8.0.0",
		"qrcode": "1.5.4",
		"sharp": "0.34.5",
		"tailwindcss": "4.1.18",
		"unzipper": "0.12.3",
		"vue": "latest",
		"vue-chrts": "2.1.1",
		"vuedraggable": "4.1.0",
		"zod": "4.3.6"
