	"devDependencies": {
		"@iconify-json/lucide": "1.2.89",
		"@nuxt/eslint": "1.15.1",
		"@nuxt/test-utils": "4.0.0",
		"@types/node": "25.2.2",
		"@types/nodemailer": "7.0.9",
		"@types/papaparse": "5.5.2",
		"@types/pg": "8.16.0",
		"@types/qrcode": "1.5.6",
		"@types/unzipper": "0.10.11",
		"@vue/test-utils": "2.4.6",
		"eslint": "10.0.0",
