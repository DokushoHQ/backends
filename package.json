{
	"name": "dokusho-backends",
	"version": "0.9.5",
	"packageManager": "pnpm@10.27.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "eslint . --fix",
		"typecheck": "nuxt typecheck",
		"db:generate": "prisma generate --schema=./prisma/schema",
		"db:migrate:dev": "prisma migrate dev --schema=./prisma/schema",
		"db:migrate": "prisma migrate deploy --schema=./prisma/schema",
		"db:studio": "prisma studio --schema=./prisma/schema",
		"processor:dev": "nuxt-processor dev",
		"test": "vitest",
		"test:run": "vitest run",
		"prepare": "husky"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.986.0",
		"@aws-sdk/lib-storage": "3.986.0",
		"@better-auth/expo": "1.4.18",
